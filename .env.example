CLICKHOUSE_URL= sample
CLICKHOUSE_USER=sample
CLICKHOUSE_PASSWORD=sample

# ClickStack / HyperDX Cloud OTLP ingestion (observability/otel.ts).
# Traces, metrics and logs all ship here. Swap the endpoint back to http://localhost:4318 to
# target the local ClickStack container instead.
# Managed ClickStack has no hosted collector and no ingestion key in the UI -- you run the
# standalone ClickStack collector yourself and pick its token. Ours listens on 4319 (4318 is
# taken by the local all-in-one container) and writes into the ClickHouse Cloud service, which
# is where HyperDX Cloud reads from. See `docker:collector` in package.json.
OTEL_EXPORTER_OTLP_ENDPOINT=sample
OTEL_INGESTION_TOKEN=sample

# The telemetry now lands in ClickHouse Cloud, so otel:verify must look there, not at the
# local container.
CLICKSTACK_CLICKHOUSE_URL=sample
CLICKSTACK_CLICKHOUSE_USER=sample
CLICKSTACK_CLICKHOUSE_PASSWORD=sample

LANGFUSE_SECRET_KEY="sample"
LANGFUSE_PUBLIC_KEY="sample"
LANGFUSE_BASE_URL="sample"

DEEPSEEK_API_KEY=
# Watchman email delivery (bun run watch).
# Deliberately the SAME names LibreChat uses, so SMTP is configured once for both.
# Leave blank and notifications still work — they are appended to
# backend/mcp/watches/notifications.jsonl instead, and the runner says which sink it used.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
# 'tls' for implicit TLS on 465; leave blank for STARTTLS on 587.
EMAIL_ENCRYPTION=

# Watchman delivery — set ONE. Tried in this order; first configured wins.
# Easiest: a Slack or Discord incoming webhook. One URL, no account to verify.
WATCH_WEBHOOK_URL=
# Real email over HTTPS. One key, no host/port/TLS/app-password.
RESEND_API_KEY=
