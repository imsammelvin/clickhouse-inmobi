# ClickHouse connection (see goal.md; defaults point at the local ClickStack dev container).
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=api
CLICKHOUSE_PASSWORD=api
CLICKHOUSE_DATABASE=default

# ClickStack OpenTelemetry ingestion (observability/otel.ts). Traces, metrics and logs all go
# over OTLP/HTTP to the collector; every value below has a working local default.
#
# OTEL_EXPORTER_OTLP_ENDPOINT  collector base URL       default http://localhost:4318
#                              local ClickStack container: http://localhost:4318
#                              HyperDX / ClickStack Cloud: https://in-otel.hyperdx.io
# OTEL_INGESTION_TOKEN         sent as the `authorization` header on every OTLP request.
#                              Local: the dev container's token (the default).
#                              Cloud: your Ingestion API Key, from HyperDX ->
#                              Team Settings -> API Keys. NOTE the cloud endpoint returns
#                              HTTP 200 even for a wrong or empty key, so a successful export
#                              is NOT proof the key is valid -- confirm in the HyperDX UI.
# OTEL_LOG_LEVEL               unset | error | warn | info | debug | verbose. Turns on OTel's
#                              own logging. Unset by default, which means export failures are
#                              silent -- set it to debug when telemetry is not showing up.
# OTEL_SERVICE_NAME            how this process is labelled in ClickStack
#                              default clickhouse-inmobi-ingest; set it per entry point so the
#                              app and the ingest scripts show up as separate services
# DEPLOYMENT_ENVIRONMENT       local | staging | prod    default local

# Where ClickStack STORES the telemetry it ingests. Read by `bun run otel:verify` and written by
# `bun run otel:schema` (which creates the otel_* tables when the collector has not already).
# To target ClickHouse Cloud, set these three to the Cloud credentials, e.g.
#   CLICKSTACK_CLICKHOUSE_URL=https://<id>.<region>.aws.clickhouse.cloud:8443
# This is a different ClickHouse from CLICKHOUSE_URL above: the fact data lives in ClickHouse
# Cloud, while the ClickStack all-in-one container keeps its otel_* tables in its own bundled
# instance. Defaults below match that container, so normally you can leave these unset.
#
# CLICKSTACK_CLICKHOUSE_URL       default http://localhost:8123
# CLICKSTACK_CLICKHOUSE_USER      default api
# CLICKSTACK_CLICKHOUSE_PASSWORD  default api
