{
  "name": "clickhouse-inmobi",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run main.ts",
    "dev": "bun --watch main.ts",
    "serve": "bun run observability/collector.ts && OTEL_SERVICE_NAME=clickhouse-inmobi-api bun run api/server.ts",
    "serve:dev": "OTEL_SERVICE_NAME=clickhouse-inmobi-api bun --watch api/server.ts",
    "otel:collector": "bun run observability/collector.ts",
    "otel:collector:stop": "docker rm -f clickstack-collector",
    "otel:collector:logs": "docker logs -f clickstack-collector",
    "otel:schema": "bun run observability/schema.ts",
    "otel:verify": "bun run observability/verify.ts",
    "ch:ping": "bun run scripts/ping.ts",
    "ch:schema": "bun run scripts/schema.ts",
    "ch:load": "bun run scripts/load.ts",
    "ch:verify": "bun run scripts/verify.ts",
    "ch:setup": "bun run ch:schema && bun run ch:load && bun run ch:verify",
    "synth:build": "bun run mcp/synth/generate.ts",
    "synth:destroy": "bun run mcp/synth/destroy.ts",
    "synth:verify": "CLICKHOUSE_DATABASE=rca_synth bun run mcp/synth/verify.ts",
    "diagnose": "OTEL_SERVICE_NAME=clickhouse-inmobi-diagnose bun run mcp/diagnose.ts",
    "mcp:stdio": "OTEL_SERVICE_NAME=clickhouse-inmobi-mcp bun run mcp/server.ts --transport stdio",
    "mcp:http": "OTEL_SERVICE_NAME=clickhouse-inmobi-mcp bun run mcp/server.ts --transport http",
    "mcp:prompt": "bun run mcp/prompt.ts",
    "mcp:eval": "OTEL_SERVICE_NAME=clickhouse-inmobi-mcp-eval bun run mcp/eval/run.ts",
    "typecheck": "tsc --noEmit",
    "criteria": "bun run backend/criteria.ts",
    "scan": "bun run backend/scan.ts",
    "bench": "bun run backend/benchmark.ts",
    "explain": "bun run backend/cli.ts",
    "build": "bun build api/server.ts --outdir dist --target=node",
    "langfuse:trace": "bun run backend/langfuse/trace-stub.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.9.6"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clickhouse/client": "^1.23.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@anthropic-ai/sdk": "^0.32.0",
    "@langfuse/tracing": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@opentelemetry/sdk-node": "^0.221.0"
  }
}
