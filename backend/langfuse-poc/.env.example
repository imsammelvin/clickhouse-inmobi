# Copy these into the repo-root .env (same file ClickHouse vars live in). Never put real keys in
# this .env.example file -- it's committed to the (public) repo, unlike .env which is gitignored.

# Self-hosted via Docker Compose (see backend/langfuse/README.md) -- only ClickHouse is cloud.
# Get these from http://localhost:3000 after `docker compose up`: create an org/project, then
# Settings -> API Keys.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Only needed for real narration text; without it trace-stub.ts prints a stub sentence instead.
DEEPSEEK_API_KEY=
